---
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Inventory from '../components/Inventory.astro';
import Lore from '../components/Lore.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
	title: string;
	description?: string;
}

const { title, description = 'Synthesized flavors for the modern renegade. High-tech burgers, low-life prices.' } = Astro.props;
---

<!DOCTYPE html>
<html lang="en" class="dark">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&display=swap" rel="stylesheet"/>
		<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet"/>
	</head>
	<body class="bg-background-light dark:bg-background-dark font-display text-white selection:bg-primary/40">
		<div class="relative min-h-screen flex flex-col overflow-x-hidden">
			<div class="fixed inset-0 scanlines z-50 opacity-20 pointer-events-none" aria-hidden="true"></div>
			<Header />
			<main class="flex-grow">
				<Hero />
				<Inventory />
				<Lore />
			</main>
			<Footer />
		</div>
	</body>
</html>
